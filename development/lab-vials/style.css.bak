:root {
  --bg: #ffffff;
  --fg: #0a0a0a;
  --muted: #6b7076;
}

* { box-sizing: border-box; }
[hidden] { display: none !important; }

html, body {
  margin: 0;
  background: var(--bg);
  color: var(--fg);
  font-family: 'DM Mono', monospace;
}

.lab {
  max-width: 1200px;
  margin: 0 auto;
  padding: 6rem 16px 4rem;
}

.intro {
  text-align: center;
  font-size: 0.95rem;
  margin: 0 0 2rem;
}

.shelf {
  position: relative;
  width: 100%;
}

#vials {
  display: block;
  width: 100%;
  touch-action: manipulation;
  -webkit-tap-highlight-color: transparent;
}

.labels {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

/* Each name sits on the shelf's front edge under its vial. It's also the
   keyboard way in: focus it and press Enter to open the vial. */
.vial-label {
  position: absolute;
  transform: translate(-50%, 0);
  pointer-events: auto;
  border: 0;
  background: none;
  padding: 0.2rem 0.4rem;
  font: inherit;
  font-size: 0.8rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--fg);
  white-space: nowrap;
  cursor: pointer;
}

.vial-label small {
  display: block;
  font-size: 0.68rem;
  letter-spacing: 0.02em;
  text-transform: none;
  color: var(--muted);
}

.vial-label:focus-visible {
  outline: 2px solid var(--fg);
  outline-offset: 2px;
}

.project {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  background: var(--bg);
  text-align: center;
  padding: 16px;
}

.project h1 {
  font-family: 'Tilt Warp', sans-serif;
  font-weight: 400;
  font-size: clamp(2.2rem, 7vw, 4.5rem);
  margin: 0;
}

.project p { margin: 0; color: var(--muted); }

.back {
  position: absolute;
  top: 1.25rem;
  left: 1.25rem;
  border: 1px solid var(--fg);
  border-radius: 999px;
  background: none;
  font: inherit;
  font-size: 0.8rem;
  padding: 0.45rem 0.9rem;
  cursor: pointer;
}

.flash {
  position: fixed;
  inset: 0;
  z-index: 25;
  background: var(--bg);
  opacity: 0;
  pointer-events: none;
}

/* Tuning panel, for dialing the glass in. */
.tune-toggle {
  position: fixed;
  right: 16px;
  bottom: 16px;
  z-index: 40;
  border: 1px solid var(--fg);
  border-radius: 999px;
  background: var(--bg);
  font: inherit;
  font-size: 0.75rem;
  padding: 0.4rem 0.8rem;
  cursor: pointer;
}

.tune {
  position: fixed;
  right: 16px;
  bottom: 56px;
  z-index: 40;
  width: min(300px, calc(100vw - 32px));
  max-height: calc(100vh - 90px);
  overflow: auto;
  background: rgba(255, 255, 255, 0.94);
  border: 1px solid #ddd;
  border-radius: 10px;
  padding: 0.75rem;
  font-size: 0.72rem;
  backdrop-filter: blur(8px);
}

.tune label {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 0.15rem 0.5rem;
  margin-bottom: 0.55rem;
}

.tune input { grid-column: 1 / -1; width: 100%; }
.tune output { color: var(--muted); }

.tune .copy {
  width: 100%;
  font: inherit;
  font-size: 0.72rem;
  padding: 0.35rem;
  border: 1px solid #ccc;
  border-radius: 6px;
  background: #fff;
  cursor: pointer;
}

.help {
  position: fixed;
  z-index: 50;
  max-width: 240px;
  background: var(--fg);
  color: #fff;
  font-size: 0.7rem;
  line-height: 1.4;
  padding: 0.5rem 0.6rem;
  border-radius: 6px;
  pointer-events: none;
}
